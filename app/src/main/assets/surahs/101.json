[{"surahNumber": 101, "ayahNumber": 1, "textArabic": "الْقَارِعَةُ", "tafsirMuyassar": "الساعة التي تقرع قلوب الناس بأهوالها.", "page": 600}, {"surahNumber": 101, "ayahNumber": 2, "textArabic": "مَا الْقَارِعَةُ", "tafsirMuyassar": "أيُّ شيء هذه القارعة؟", "page": 600}, {"surahNumber": 101, "ayahNumber": 3, "textArabic": "وَمَا أَدْرَاكَ مَا الْقَارِعَةُ", "tafsirMuyassar": "وأيُّ شيء أعلمك بها؟", "page": 600}, {"surahNumber": 101, "ayahNumber": 4, "textArabic": "يَوْمَ يَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِ", "tafsirMuyassar": "في ذلك اليوم يكون الناس في كثرتهم وتفرقهم وحركتهم كالفراش المنتشر، وهو الذي يتساقط في النار.", "page": 600}, {"surahNumber": 101, "ayahNumber": 5, "textArabic": "وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوشِ", "tafsirMuyassar": "وتكون الجبال كالصوف متعدد الألوان الذي يُنْفَش باليد، فيصير هباء ويزول.", "page": 600}, {"surahNumber": 101, "ayahNumber": 6, "textArabic": "فَأَمَّا مَنْ ثَقُلَتْ مَوَازِينُهُ", "tafsirMuyassar": "فأما من رجحت موازين حسناته، فهو في حياة مرضية في الجنة.", "page": 600}, {"surahNumber": 101, "ayahNumber": 7, "textArabic": "فَهُوَ فِي عِيشَةٍ رَاضِيَةٍ", "tafsirMuyassar": "فأما من رجحت موازين حسناته، فهو في حياة مرضية في الجنة.", "page": 600}, {"surahNumber": 101, "ayahNumber": 8, "textArabic": "وَأَمَّا مَنْ خَفَّتْ مَوَازِينُهُ", "tafsirMuyassar": "وأما من خفت موازين حسناته، ورجحت موازين سيئاته، فمأواه جهنم.", "page": 600}, {"surahNumber": 101, "ayahNumber": 9, "textArabic": "فَأُمُّهُ هَاوِيَةٌ", "tafsirMuyassar": "وأما من خفت موازين حسناته، ورجحت موازين سيئاته، فمأواه جهنم.", "page": 600}, {"surahNumber": 101, "ayahNumber": 10, "textArabic": "وَمَا أَدْرَاكَ مَا هِيَهْ", "tafsirMuyassar": "وما أدراك -أيها الرسول- ما هذه الهاوية؟", "page": 600}, {"surahNumber": 101, "ayahNumber": 11, "textArabic": "نَارٌ حَامِيَةٌ", "tafsirMuyassar": "إنها نار قد حَمِيت من الوقود عليها.", "page": 600}]