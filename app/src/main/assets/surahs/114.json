[{"surahNumber": 114, "ayahNumber": 1, "textArabic": "قُلْ أَعُوذُ بِرَبِّ النَّاسِ", "tafsirMuyassar": "قل -أيها الرسول-: أعوذ وأعتصم برب الناس، القادر وحده على ردِّ شر الوسواس.", "page": 604}, {"surahNumber": 114, "ayahNumber": 2, "textArabic": "مَلِكِ النَّاسِ", "tafsirMuyassar": "ملك الناس المتصرف في كل شؤونهم، الغنيِّ عنهم.", "page": 604}, {"surahNumber": 114, "ayahNumber": 3, "textArabic": "إِلَٰهِ النَّاسِ", "tafsirMuyassar": "إله الناس الذي لا معبود بحق سواه.", "page": 604}, {"surahNumber": 114, "ayahNumber": 4, "textArabic": "مِنْ شَرِّ الْوَسْوَاسِ الْخَنَّاسِ", "tafsirMuyassar": "من أذى الشيطان الذي يوسوس عند الغفلة، ويختفي عند ذكر الله.", "page": 604}, {"surahNumber": 114, "ayahNumber": 5, "textArabic": "الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ", "tafsirMuyassar": "الذي يبثُّ الشر والشكوك في صدور الناس.", "page": 604}, {"surahNumber": 114, "ayahNumber": 6, "textArabic": "مِنَ الْجِنَّةِ وَالنَّاسِ", "tafsirMuyassar": "من شياطين الجن والإنس.", "page": 604}]